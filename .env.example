NEXTCLOUD_VERSION=34-fpm

VIRTUAL_HOST=
LETSENCRYPT_HOST=
LETSENCRYPT_EMAIL=

# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=

POSTGRES_PASSWORD=
NEXTCLOUD_BACKUP_DIR=/backups
NEXTCLOUD_UPGRADE_MIN_FREE_MB=2048

NEXTCLOUD_ADMIN_USER=
NEXTCLOUD_ADMIN_PASSWORD=

# Space-separated trusted domains, for example: "web yourdomain.tld"
NEXTCLOUD_TRUSTED_DOMAINS=

# Garage S3 primary storage (used by docker-compose-garages3.yml)
# GARAGES3_KEY is the Garage key name created by scripts/bootstrap-garages3.sh.
# GARAGES3_KEY_ID is the access key ID consumed by Nextcloud.
GARAGES3_BUCKET=nextcloud
GARAGES3_KEY=
GARAGES3_KEY_ID=
GARAGES3_SECRET=
GARAGES3_HOSTNAME=host.docker.internal
GARAGES3_PORT=3900
GARAGES3_REGION=garage
GARAGES3_USE_SSL=false
GARAGES3_USE_PATH_STYLE=true
GARAGES3_AUTOCREATE=true
GARAGES3_VERIFY_BUCKET_EXISTS=true
